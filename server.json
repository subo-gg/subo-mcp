{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "gg.subo/subo",
  "title": "Subo",
  "description": "Run Discord forms, surveys, polls and quizzes from your AI app: build, launch and analyze projects.",
  "version": "1.0.0",
  "websiteUrl": "https://subo.gg/blog/connect-discord-community-to-ai-agent/",
  "repository": {
    "url": "https://github.com/subo-gg/subo-mcp",
    "source": "github",
    "id": "1400875062"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.subo.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Subo API key of type \"Bot or agent\", created by a community Admin on the Account page (https://app.subo.gg/app/account) under API Access.",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Subo API key (starts with sbo_live_)",
              "placeholder": "sbo_live_...",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
